# Modelo do .env — COPIE para .env e preencha.
# O .env real está no .gitignore e NUNCA vai pro repositório.
#   cp .env.example .env

# --- Instância do n8n (spec.md seção 7.5) ---
N8N_BASE_URL=https://n8n.carvalhodeoliveira.com

# Chave de API criada em Settings -> n8n API dentro do n8n.
# É um segredo: dá acesso total à instância (workflows e execuções).
N8N_API_KEY=cole-a-chave-aqui

# --- IDs reais das credenciais dentro do n8n ---
# Servem pra o deploy já subir o workflow com as credenciais amarradas,
# sem precisar reselecionar nada na tela a cada atualização.
# Como descobrir cada ID: abra a credencial no n8n e olhe a URL —
#   https://.../home/credentials/<ESTE-PEDACO-É-O-ID>
# (o script scripts/descobrir_credenciais.js tenta listar isso sozinho)
N8N_CRED_GMAIL_HOMOLOG=
N8N_CRED_GMAIL_PRODUCAO=
N8N_CRED_BOX=
N8N_CRED_CLAUDE_DEV=
N8N_CRED_CLAUDE_PRODUCAO=
N8N_CRED_GDRIVE_TRABALHO=
N8N_CRED_GDRIVE_PARTICULAR_MICHELLE=
N8N_CRED_GDRIVE_HOMOLOG=
N8N_CRED_TELEGRAM=
