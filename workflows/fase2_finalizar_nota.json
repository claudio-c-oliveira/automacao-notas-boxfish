    {
      "parameters": {
        "jsCode": "// Gera retranca (secao 4.1), nome da pasta de vencimento (secao 4.4) e nome\n// da pasta por função (secao 4.2 - coluna B \"CONTA NETFLIX\" = codigo, coluna C\n// \"ÍTEM\" = cargo, confirmado).\nfunction formatarDataCurta(d) { return String(d.getDate()).padStart(2,'0') + '.' + String(d.getMonth()+1).padStart(2,'0'); }\nfunction formatarNumeroNota(numero) { const digitos = String(numero).replace(/\\D/g, ''); return digitos.padStart(6, '0').slice(-6); }\nconst MESES_ABREV_PT_MAIUSC = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];\nfunction montarNomePastaVencimento(d) { return 'VENC_' + MESES_ABREV_PT_MAIUSC[d.getMonth()] + '_' + formatarDataCurta(d); }\nfunction montarNomePastaFuncao(codigo, cargo, projetoId) {\n  const sufixo = projetoId === 'REUNION' ? '.R' : '';\n  return codigo + sufixo + ' - ' + cargo;\n}\n\nconst d = $input.first().json;\nconst dataVencimento = new Date(d.dataVencimento);\nconst numeroFormatado = formatarNumeroNota(d.numeroNota);\nconst retranca = formatarDataCurta(dataVencimento) + '_BR_SMTC_' + d.perfilRetranca + '_' + d.razaoSocialOuNome + '_#' + numeroFormatado;\nconst pastaVencimento = montarNomePastaVencimento(dataVencimento);\nconst pastaFuncao = montarNomePastaFuncao(d.codigo, d.cargo, d.projetoId);\n\nreturn [{ json: { ...d, dataVencimento: dataVencimento.toISOString(), numeroFormatado, retranca, pastaVencimento, pastaFuncao } }];"
      },
