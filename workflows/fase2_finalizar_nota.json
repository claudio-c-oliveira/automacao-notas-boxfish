      "id": "f2f-15-box-download",
      "name": "Box — Download planilha",
      "type": "n8n-nodes-base.box",
      "typeVersion": 1,
      "position": [
        1980,
        0
      ],
      "credentials": {
        "boxOAuth2Api": {
