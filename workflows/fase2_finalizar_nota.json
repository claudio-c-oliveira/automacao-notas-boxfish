    {
      "parameters": {
        "jsCode": "// Marca a nota como recebida em cobrancas.json (status_ciclo='recebido') — a\n// Fase 1 (Avaliar cobrança) para de monitorar/cobrar assim que vir esse status.\nfunction parseBinaryJson(item) {\n  if (!item || !item.binary || !item.binary.data) return {};\n  return JSON.parse(Buffer.from(item.binary.data.data, 'base64').toString('utf8'));\n}\nconst item = $('Ler cobrancas.json').first();\nconst cobrancas = parseBinaryJson(item);\nconst chave = $('Gerar retranca e nomes de pasta').first().json.chaveCobranca;\nif (chave && cobrancas[chave]) {\n  cobrancas[chave].status_ciclo = 'recebido';\n}\nreturn [{ json: {}, binary: { data: { data: Buffer.from(JSON.stringify(cobrancas, null, 2)).toString('base64'), mimeType: 'application/json', fileName: 'cobrancas.json' } } }];"
      },
      "id": "f2f-20-atualizar-cobrancas",
      "name": "Marcar cobrancas.json como recebido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        200
      ]
