    {
      "parameters": {
        "jsCode": "// Aplica colunas D (tipo doc), E (nº nota 6 dígitos), F (data emissão) e\n// Status Box (coluna L) = \"RECEBIDA MI\" na linha identificada (seção 4).\n// SEMPRE automático, mesmo no MVP (MODO_EXECUCAO não bloqueia isso — seção 3.1.3/4).\nconst ExcelJS = require('exceljs');\n\nconst d = $('Gerar retranca e nomes de pasta').first().json;\nconst item = $input.first();\nconst buffer = Buffer.from(item.binary.data.data, 'base64');\nconst wb = new ExcelJS.Workbook();\nawait wb.xlsx.load(buffer);\nconst ws = wb.getWorksheet('Notas') || wb.worksheets[0];\n\nws.getCell('D' + d.linha).value = d.tipoDocumento;\nws.getCell('E' + d.linha).value = d.numeroFormatado;\nws.getCell('F' + d.linha).value = d.dataEmissao;\nws.getCell('L' + d.linha).value = 'RECEBIDA MI';\n\nconst novoBuffer = await wb.xlsx.writeBuffer();\nreturn [{\n  json: { ...d },\n  binary: { data: { data: Buffer.from(novoBuffer).toString('base64'), mimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', fileName: 'cost_report_atualizado.xlsx' } },\n}];"
      },
      "id": "f2f-16-atualizar-planilha",
      "name": "Atualizar colunas D/E/F e Status Box (exceljs)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ]
    },
    {
